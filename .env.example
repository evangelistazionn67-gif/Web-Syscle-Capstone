# Copy this file to ".env" and fill it in. ".env" is git-ignored: never commit real values.
MYSQL_ROOT_PASSWORD=change-me
# first admin login (username: admin). 8 to 14 characters. Only used when the admin account does not exist yet.
ADMIN_PASSWORD=change-me-8-14
# 32+ random characters. Encrypts the stored 2FA secrets. If empty, the app makes one and keeps it in the database.
SECURITY_DATA_KEY=
# true = online payments use a practice payment page (for demos). Leave false in production.
PAYMENTS_TEST_MODE=false
SENDGRID_API_KEY=
PAYMONGO_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
