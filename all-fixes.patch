+# first admin login (username: admin). 8 to 64 characters. Only used when the admin account does not exist yet.
+ADMIN_PASSWORD=change-me-8-64
 # 32+ random characters. Encrypts the stored 2FA secrets. If empty, the app makes one and keeps it in the database.
 SECURITY_DATA_KEY=
 # true = online payments use a practice payment page (for demos). Leave false in production.
 PAYMENTS_TEST_MODE=false
+# false = the app is reached directly (default for docker compose). true = a reverse proxy / hosting platform in front of the app adds the real visitor address.
+TRUST_PROXY=false
+# true once the live site is served over HTTPS; keep false for http://localhost:8080 testing.
+SECURE_COOKIES=false
 SENDGRID_API_KEY=
 PAYMONGO_SECRET_KEY=
 PAYPAL_CLIENT_ID=
